MASM
INCLUDE Irvine32.inc

.data
    muestra DWORD 50
    msgOptimo BYTE "Voltaje optimo: balance de energia correcto", 0
    msgFuera BYTE "Voltaje fuera de norma: ", 0
    msgFin BYTE "Registro guardado en memoria", 0

.code
main PROC
    mov eax, muestra
    imul eax, 4

    cmp eax, 200
    je Optimo

    mov edx, OFFSET msgFuera
    call WriteString
    call WriteDec
    call Crlf
    jmp Fin

Optimo:
    mov edx, OFFSET msgOptimo
    call WriteString
    call Crlf

Fin:
    mov edx, OFFSET msgFin
    call WriteString
    call Crlf
    exit
main ENDP
END main
