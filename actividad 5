MASM
INCLUDE Irvine32.inc

.data
    valorInicial DWORD ?

.code
main PROC
    mov eax, 5                  ; Valor inicial de ejemplo en EAX
    mov valorInicial, eax       ; Ejercicio 5.1: Guardar valor inicial en variable
    
