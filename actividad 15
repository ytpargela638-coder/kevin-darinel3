MASM
INCLUDE Irvine32.inc

.data
    fallos1 DWORD 0
    fallos2 DWORD 2
    fallos3 DWORD 1
    alertas DWORD 0
    msgAlerta BYTE "Alerta: actividad sospechosa detectada", 0
    msgLimpio BYTE "Acceso sin incidentes", 0
    msgFin BYTE "Fin de auditoria", 0

.code
main PROC
    mov eax, fallos1
    add eax, fallos2
    add eax, fallos3

    cmp eax, 0
    je SinIncidentes

    inc alertas
    mov edx, OFFSET msgAlerta
    call WriteString
    call Crlf
    jmp Fin

SinIncidentes:
    mov edx, OFFSET msgLimpio
    call WriteString
    call Crlf

Fin:
    mov edx, OFFSET msgFin
    call WriteString
    call Crlf
    exit
main ENDP
END main
